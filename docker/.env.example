# Copy to docker/.env and fill in. Docker Compose reads it automatically.

# NFS server for downloads and work copies (seeding torrents live here)
NAS_ADDR=192.0.2.10
NAS_EXPORT=/export/dreamingtree-dl

# NFS server holding the music library that Plex reads
MEDIA_ADDR=192.0.2.20
MEDIA_EXPORT=/srv/music

# uid/gid the containers run as: use the owner of your music library (often the plex user)
APP_UID=997
APP_GID=997
# your own group on the Docker host, so you can still edit data/config.json
HOST_GID=1000

# SSH target for the Plex deep-analysis helper (see docs/OPERATIONS.md)
PLEX_SSH=plex@media-server
